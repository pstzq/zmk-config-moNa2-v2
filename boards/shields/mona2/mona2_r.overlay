#include "mona2.dtsi"
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/zmk-input-processor-keybind.dtsi>

// zip_mouse_gesture_win / mouse-gesture.dtsi は mona2.dtsi で定義・include 済み。

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    // SPI pin setup for right-side trackball
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    // Low-power pin state while sleeping
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <600>;
        // swap-xy;
        // invert-x;
        // invert-y;
        evt-type = <INPUT_EV_REL>;
        // 慣性スクロール設定（無効にする場合は以下をコメントアウト）
        inertial-scroll;
        inertial-scroll-layers = <3 4 5>;   // NUM/NAV_MAC/NAV_WIN でスクロール有効
        inertial-scroll-gain-pct = <100>;   // 指を離した瞬間の初速の強さ (130→100: 増幅なし)
        inertial-scroll-decay-pct = <93>;   // 1回ごとの速度残存率(%) (99→93: 約0.5秒で停止)
        inertial-scroll-interval-ms = <10>; // 慣性更新周期(ms)
        inertial-scroll-threshold = <4>;    // 停止判定の下限値
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// 20260404
&zip_temp_layer {
    excluded-positions = <0 10 17 18 19 21 29 31>;
    require-prior-idle-ms = <300>;  // 好きなmsに調整（例: 300ms）
};

// Runtime input listener for right-side trackball
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    // オートマウスレイヤー(AML): ボール操作で MOUSE 層(=6) を一時有効化
    input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT &mouse_runtime_input_processor &zip_temp_layer 6 500>;

    scroller {
        layers = <3 4 5>;   // NUM(3)/NAV_MAC(4)/NAV_WIN(5) でスクロール有効
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT
             &zip_xy_to_scroll_mapper
             &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
             &zip_scroll_scaler 1 5
             &scroll_runtime_input_processor>;
    };

    // P長押し(layer 8): 2D自由スクロール(パン)。scroller と同構成・同速度
    panner {
        layers = <8>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT
             &zip_xy_to_scroll_mapper
             &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
             &zip_scroll_scaler 1 5
             &scroll_runtime_input_processor>;
    };

    // Del長押し(layer 9): Mac ウィンドウスナップ(Rectangle)
    gesturer_mac {
        layers = <9>;
        input-processors = <&zip_mouse_gesture>;
    };

    // Del長押し(layer 10): Win ウィンドウスナップ(Win+矢印)
    gesturer_win {
        layers = <10>;
        input-processors = <&zip_mouse_gesture_win>;
    };

    // Q 長押し(layer 11): トラックボール → 矢印キー入力
    // zip_keybind_keys は XY イベントを消費しないため、後続で XY→scroll 変換して
    // mouse_runtime_input_processor へ XY が届かないようにする (マウスカーソル移動防止)
    cursor_keys {
        layers = <11>;
        input-processors =
            <&zip_keybind_keys
             &zip_xy_to_scroll_mapper
             &zip_scroll_scaler 1 100>;
    };
};

