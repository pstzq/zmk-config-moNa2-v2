#include "mona2.dtsi"
#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <input/processors/zmk-input-processor-keybind.dtsi>

// zip_mouse_gesture_win / mouse-gesture.dtsi は mona2.dtsi で定義・include 済み。

&default_transform {
    col-offset = <6>;
};

&kscan0 {
    col-gpios
        = <&xiao_d 10 GPIO_ACTIVE_HIGH>
        , <&xiao_d 9 GPIO_ACTIVE_HIGH>
        , <&xiao_d 8 GPIO_ACTIVE_HIGH>
        , <&xiao_d 7 GPIO_ACTIVE_HIGH>
        , <&gpio0 10 GPIO_ACTIVE_HIGH>
        ;
};

&pinctrl {
    // SPI pin setup for right-side trackball
    spi0_default: spi0_default {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
        };
    };

    // Low-power pin state while sleeping
    spi0_sleep: spi0_sleep {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 0, 5)>,
                <NRF_PSEL(SPIM_MOSI, 0, 4)>,
                <NRF_PSEL(SPIM_MISO, 0, 4)>;
            low-power-enable;
        };
    };
};

&spi0 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi0_default>;
    pinctrl-1 = <&spi0_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;

    trackball_central: trackball_central@0 {
        status = "okay";
        compatible = "pixart,pmw3610";
        reg = <0>;
        spi-max-frequency = <2000000>;
        irq-gpios = <&gpio0 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        cpi = <800>;  // 600→800: センサー感度アップ。スクロール/ジェスチャー側は scaler・threshold・stroke-size で補正済み
        // swap-xy;
        // invert-x;
        // invert-y;
        evt-type = <INPUT_EV_REL>;
        // 慣性スクロール設定（無効にする場合は以下をコメントアウト）
        inertial-scroll;
        inertial-scroll-layers = <4 5 6>;   // NUM/NAV_MAC/NAV_WIN でスクロール有効
        inertial-scroll-gain-pct = <200>;   // 初速を2倍に増幅。軽いスワイプでも慣性感を体感できる量にする
        inertial-scroll-decay-pct = <93>;   // 1回ごとの速度残存率(%)。約0.4〜0.7秒でスーッと停止
        inertial-scroll-interval-ms = <10>; // 慣性更新周期(ms)
        inertial-scroll-threshold = <10>;   // 停止判定の下限値 (cpi 600→800 に合わせ 8→10 に比例補正)
        x-input-code = <INPUT_REL_X>;
        y-input-code = <INPUT_REL_Y>;
    };
};

// 20260404
&zip_temp_layer {
    excluded-positions = <0 10 17 18 19 21 29 31>;
    require-prior-idle-ms = <300>;  // 好きなmsに調整（例: 300ms）
};

// Runtime input listener for right-side trackball
&trackball_central_listener {
    status = "okay";
    device = <&trackball_central>;
    // オートマウスレイヤー(AML): ボール操作で MOUSE 層(=6) を一時有効化
    input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT &mouse_runtime_input_processor &zip_temp_layer 7 500>;

    scroller {
        layers = <4 5 6>;   // NUM(4)/NAV_MAC(5)/NAV_WIN(6) でスクロール有効
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT
             &zip_xy_to_scroll_mapper
             &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
             &zip_scroll_scaler 1 5
             &scroll_runtime_input_processor>;   // scaler 1/4→1/5: cpi 600→800 の補正(体感速度ほぼ同等)
    };

    // P長押し(layer 9): 2D自由スクロール(パン)。scroller と同構成・同速度
    panner {
        layers = <9>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_X_INVERT
             &zip_xy_to_scroll_mapper
             &zip_scroll_transform INPUT_TRANSFORM_X_INVERT
             &zip_scroll_scaler 1 5
             &scroll_runtime_input_processor>;   // scaler 1/4→1/5: cpi 600→800 の補正(体感速度ほぼ同等)
    };

    // Q長押し(layer 10): Mac ウィンドウスナップ(Rectangle)
    // X_INVERT はデフォルトチェーンと同じ向き補正(無いと左右ストロークが反転する)
    gesturer_mac {
        layers = <10>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT &zip_mouse_gesture>;
    };

    // Q長押し(layer 11): Win ウィンドウスナップ(Win+矢印)
    gesturer_win {
        layers = <11>;
        input-processors = <&zip_xy_transform INPUT_TRANSFORM_X_INVERT &zip_mouse_gesture_win>;
    };

};

