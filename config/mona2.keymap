/*
 * moNa2 keymap (Phase 1) - JIS運用 / WIN・MAC分離 / DYA Studio対応
 * 設計: zmk-keyboard/REQUIREMENTS.md
 * レイアウト図: zmk-keyboard/draw/mona2_phase1.svg
 */

#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "jis.h"

#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

/* ---- レイヤー定義 ---- */

#define MAC     0   // ベース(Mac)        — デフォルト
#define WIN     1   // ベース(Windows)
#define SYM     2   // 記号
#define NUM     3   // 数字(右手テンキー)
#define NAV_MAC 4   // 矢印/ナビ(Mac)     — P=Cmd+Shift+3
#define NAV_WIN 5   // 矢印/ナビ(Windows) — P=PrtSc
#define MOUSE   6   // マウス(オートマウスレイヤー)
#define BLE     7   // BT/設定

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // S+D = Tab

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <WIN MAC>;
        };

        // D+F = Shift+Tab

        combo_stab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <WIN MAC>;
        };

        // 英数+かな = tap:Esc / hold:BLE層 (sayu-hub意識)

        combo_esc_ble {
            bindings = <&lt BLE ESC>;
            key-positions = <38 39>;
            layers = <WIN MAC>;
        };

        // J+K = コピー / K+L = ペースト (OS別に修飾を分岐)

        combo_copy_mac {
            bindings = <&kp LG(C)>;
            key-positions = <17 18>;
            layers = <MAC>;
        };

        combo_copy_win {
            bindings = <&kp LC(C)>;
            key-positions = <17 18>;
            layers = <WIN>;
        };

        combo_paste_mac {
            bindings = <&kp LG(V)>;
            key-positions = <18 19>;
            layers = <MAC>;
        };

        combo_paste_win {
            bindings = <&kp LC(V)>;
            key-positions = <18 19>;
            layers = <WIN>;
        };
    };

    macros {
        // OSをBTプロファイルに紐づけて切替 (BT0=Mac / BT1=Win / BT2=Win)

        bt_mac0: bt_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC &bt BT_SEL 0>;
            label = "BT_MAC0";
        };

        bt_win1: bt_win1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 1>;
            label = "BT_WIN1";
        };

        bt_win2: bt_win2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 2>;
            label = "BT_WIN2";
        };

        // Mac: ⌘⇧4 → Space で「ウィンドウ単位」スクショ (2段操作をマクロ化)
        ss_window_mac: ss_window_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(LS(N4))>, <&kp SPACE>;
            label = "SS_WINDOW_MAC";
        };
    };

    behaviors {
        // Backspace 専用 mod-tap: タップ→即長押し(quick-tap)で BS をオートリピート
        mt_bspc: mt_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
        };

        // エンコーダ: runtime-sensor-rotate (DYA Studioから動的変更可)

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <100>;
        };

        scroll_right_left: scroll_right_left {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_RIGHT>;
            ccw-binding = <&msc SCRL_LEFT>;
            tap-ms = <100>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
            tap-ms = <100>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "MAC";
            bindings = <
&kp Q        &kp W      &kp E     &kp R          &kp T                                          &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A        &kp S      &kp D     &kp F          &kp G                           &kp JIS_AT     &kp H      &kp J  &kp K      &kp L    &mt LGUI JIS_MINUS
&mt LSHFT Z  &kp X      &kp C     &kp V          &kp B          &caps_word       &kp JIS_UNDER  &kp N      &kp M  &kp COMMA  &kp DOT  &mt RSHFT JIS_FSLH
&kp LGUI     &kp LCTRL  &kp LALT  &mt_bspc LGUI BSPC  &lt SYM SPACE  &lt NAV_MAC LANG2    &lt NAV_MAC LANG1  &lt NUM ENTER                             &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        win_layer {
            display-name = "WIN";
            bindings = <
&kp Q        &kp W     &kp E     &kp R           &kp T                                          &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A        &kp S     &kp D     &kp F           &kp G                           &kp JIS_AT     &kp H      &kp J  &kp K      &kp L    &mt RCTRL JIS_MINUS
&mt LSHFT Z  &kp X     &kp C     &kp V           &kp B          &caps_word       &kp JIS_UNDER  &kp N      &kp M  &kp COMMA  &kp DOT  &mt RSHFT JIS_FSLH
&kp LCTRL    &kp LGUI  &kp LALT  &mt_bspc LCTRL BSPC  &lt SYM SPACE  &lt NAV_WIN LANG2    &lt NAV_WIN LANG1  &lt NUM ENTER                             &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp JIS_EXCL   &kp JIS_DQT    &kp JIS_HASH   &kp JIS_DLR    &kp JIS_PCT                            &kp JIS_AMPS   &kp JIS_QUOTE  &kp JIS_LPAR  &kp JIS_RPAR  &kp JIS_PIPE
&kp JIS_CARET  &kp JIS_TILDE  &kp JIS_PLUS   &kp JIS_MINUS  &kp JIS_STAR               &kp JIS_GRV  &kp JIS_LBRC   &kp JIS_RBRC  &kp JIS_LBKT  &kp JIS_RBKT  &kp JIS_EQUAL
&kp N1         &kp N2         &kp N3         &kp N4         &kp N5         &kp JIS_SEMI   &kp JIS_COLON  &kp N6     &kp N7         &kp N8        &kp N9        &kp N0
&trans         &trans         &trans         &kp BSPC       &trans         &trans    &trans  &kp ENTER                                                &kp JIS_YEN
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp F1    &kp F2     &kp F3     &kp F4     &kp F5                    &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_DIVIDE
&kp F6    &kp F7     &kp F8     &kp F9     &kp F10           &trans  &kp KP_PLUS      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&kp F11   &kp F12    &trans     &trans     &trans    &trans   &trans  &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
&trans    &trans     &trans     &trans     &trans    &trans   &trans  &kp ENTER                                          &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        nav_mac_layer {
            display-name = "NAV-M";
            bindings = <
&kp ESC   &trans     &kp UP     &trans     &kp LC(UP)                        &trans  &ss_window_mac  &kp UP  &kp LG(LS(N4))  &kp LG(LS(N3))
&kp HOME  &kp LEFT   &kp DOWN   &kp RIGHT  &kp END                  &trans  &kp C_MUTE  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&kp LSHFT  &kp PG_UP  &kp PG_DN  &trans     &trans     &trans        &trans  &kp C_VOL_DN  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_VOL_UP
&trans    &trans     &trans     &kp BSPC   &kp SPACE  &trans        &trans  &kp ENTER                              &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        nav_win_layer {
            display-name = "NAV-W";
            bindings = <
&kp ESC   &trans     &kp UP     &trans     &kp LG(TAB)                  &trans  &kp LA(PSCRN)  &kp UP  &kp LG(LS(S))  &kp PSCRN
&kp HOME  &kp LEFT   &kp DOWN   &kp RIGHT  &kp END              &trans  &kp C_MUTE  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
&kp LSHFT  &kp PG_UP  &kp PG_DN  &trans     &trans     &trans    &trans  &kp C_VOL_DN  &kp C_PREV  &kp C_PP  &kp C_NEXT  &kp C_VOL_UP
&trans    &trans     &trans     &kp BSPC   &kp SPACE  &trans    &trans  &kp ENTER                              &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        ble_layer {
            display-name = "BLE";
            bindings = <
&trans   &trans   &trans  &trans  &trans                          &bt_mac0      &bt_win1  &bt_win2  &bt BT_SEL 3  &bt BT_SEL 4
&trans   &trans   &trans  &trans  &trans             &trans       &out OUT_TOG  &trans      &trans    &trans        &studio_unlock
&trans   &trans   &trans  &trans  &trans   &trans    &bootloader  &trans        &trans    &trans    &trans        &bt BT_CLR
&trans   &trans   &trans  &trans  &trans   &trans    &trans       &trans                                          &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol>;
        };
    };
};
