/*
 * moNa2 keymap - JIS運用 / WIN・MAC分離 / DYA Studio対応
 * 設計: docs/keymap-phase1.md
 * レイアウト図: keymap-drawer/mona2_jis.svg
 */

#include <input/processors.dtsi>
#include <input/processors/runtime-input-processor.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <behaviors/battery_history_request.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include "jis.h"
#include <dt-bindings/zmk/mouse-gesture.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

/* mod-tap 誤爆対策 (&mt / mt_bspc):
 * 直前のキー入力からこの時間(ms)以内は hold(修飾キー)が発動せず tap 扱いになる。
 * 0 にすると無効化(従来挙動) */
#define MT_REQUIRE_PRIOR_IDLE_MS 125

/* ---- レイヤー定義 ---- */

#define MAC          0   // ベース(Mac)        — デフォルト
#define WIN          1   // ベース(Windows)
#define O24          2   // 代替アルファ（Q+Pトグル）
#define SYM          3   // 記号
#define NUM          4   // 数字(右手テンキー)
#define NAV_MAC      5   // 矢印/ナビ(Mac)     — P=Cmd+Shift+3
#define NAV_WIN      6   // 矢印/ナビ(Windows) — P=PrtSc
#define MOUSE        7   // マウス(オートマウスレイヤー)
#define BLE          8   // BT/設定
#define GESTURE_PAN  9   // P長押し → 2D自由スクロール(パン)
#define GESTURE_SNAP_MAC 10  // Q長押し(Mac) → ウィンドウスナップ(Rectangle)
#define GESTURE_SNAP_WIN 11  // Q長押し(Win) → ウィンドウスナップ(Win+矢印)
#define CURSOR       12  // (現在未使用)  長押し → トラックボールで矢印キー入力

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
#if MT_REQUIRE_PRIOR_IDLE_MS > 0
    require-prior-idle-ms = <MT_REQUIRE_PRIOR_IDLE_MS>;
#endif
};

&lt {
    quick-tap-ms = <200>;
    flavor = "balanced";
};

/ {
    combos {
        compatible = "zmk,combos";

        // S+D = Tab

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <11 12>;
            layers = <WIN MAC>;
        };

        // D+F = Shift+Tab

        combo_stab {
            bindings = <&kp LS(TAB)>;
            key-positions = <12 13>;
            layers = <WIN MAC>;
        };

        // 英数+かな = tap:Esc / hold:BLE層 (sayu-hub意識)

        combo_esc_ble {
            bindings = <&lt BLE ESC>;
            key-positions = <38 39>;
            layers = <WIN MAC O24>;  // O24 トグル中も BLE 層へ入れるよう含める
        };

        // J+K = コピー / K+L = ペースト (OS別に修飾を分岐)

        combo_copy_mac {
            bindings = <&kp LG(C)>;
            key-positions = <17 18>;
            layers = <MAC>;
        };

        combo_copy_win {
            bindings = <&kp LC(C)>;
            key-positions = <17 18>;
            layers = <WIN>;
        };

        combo_paste_mac {
            bindings = <&kp LG(V)>;
            key-positions = <18 19>;
            layers = <MAC>;
        };

        combo_paste_win {
            bindings = <&kp LC(V)>;
            key-positions = <18 19>;
            layers = <WIN>;
        };

        combo_toO24 {
            bindings = <&tog O24>;
            key-positions = <0 9>;
            layers = <MAC WIN O24>;  // 機能層での Q+P 誤爆を防止
        };
    };

    macros {
        // OSをBTプロファイルに紐づけて切替 (BT0=Mac / BT1=Win / BT2=Win)

        bt_mac0: bt_mac0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to MAC &bt BT_SEL 0>;
            label = "BT_MAC0";
        };

        bt_win1: bt_win1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 1>;
            label = "BT_WIN1";
        };

        bt_win2: bt_win2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to WIN &bt BT_SEL 2>;
            label = "BT_WIN2";
        };

        // Mac: ⌘⇧4 → Space で「ウィンドウ単位」スクショ (2段操作をマクロ化)

        ss_window_mac: ss_window_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(LS(N4)) &kp SPACE>;
            label = "SS_WINDOW_MAC";
        };

        // Win: 対角スナップ (2ストローク: Win+方向 × 2)

        snap_w_tl: snap_w_tl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(LEFT) &kp LG(UP)>;
            label = "SNAP_W_TL";
        };

        snap_w_tr: snap_w_tr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(RIGHT) &kp LG(UP)>;
            label = "SNAP_W_TR";
        };

        snap_w_bl: snap_w_bl {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(LEFT) &kp LG(DOWN)>;
            label = "SNAP_W_BL";
        };

        snap_w_br: snap_w_br {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <50>;
            tap-ms = <30>;
            bindings = <&kp LG(RIGHT) &kp LG(DOWN)>;
            label = "SNAP_W_BR";
        };
    };

    behaviors {
        // Backspace 専用 mod-tap: タップ→即長押し(quick-tap)で BS をオートリピート

        mt_bspc: mt_bspc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;

            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
#if MT_REQUIRE_PRIOR_IDLE_MS > 0
            require-prior-idle-ms = <MT_REQUIRE_PRIOR_IDLE_MS>;
#endif
        };

        // エンコーダ: runtime-sensor-rotate (DYA Studioから動的変更可)

        scroll_up_down: scroll_up_down {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
            tap-ms = <100>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            cw-binding = <&kp C_VOL_DN>;
            ccw-binding = <&kp C_VOL_UP>;
            tap-ms = <100>;
        };

    };

    keymap {
        compatible = "zmk,keymap";

        mac_layer {
            display-name = "MAC";
            bindings = <
&lt GESTURE_SNAP_MAC Q  &kp W      &kp E     &kp R               &kp T                                                  &kp Y          &kp U  &kp I      &kp O    &lt GESTURE_PAN P
&kp A                   &kp S      &kp D     &kp F               &kp G                       &kp JIS_AT             &kp H          &kp J  &kp K      &kp L    &mt RGUI JIS_MINUS
&mt LSHFT Z             &kp X      &kp C     &kp V               &kp B        &caps_word     &kp JIS_UNDER          &kp N          &kp M  &kp COMMA  &kp DOT  &mt RSHFT JIS_FSLH
&kp LGUI                &kp LCTRL  &kp LALT  &mt_bspc LGUI BSPC  &lt SYM SPACE  &lt NAV_MAC LANG2    &lt NAV_MAC LANG1  &lt NUM ENTER                             &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        win_layer {
            display-name = "WIN";
            bindings = <
&lt GESTURE_SNAP_WIN Q  &kp W     &kp E     &kp R                &kp T                                                  &kp Y          &kp U  &kp I      &kp O    &lt GESTURE_PAN P
&kp A                  &kp S     &kp D     &kp F                &kp G                       &kp JIS_AT             &kp H          &kp J  &kp K      &kp L    &mt RCTRL JIS_MINUS
&mt LSHFT Z            &kp X     &kp C     &kp V                &kp B        &caps_word     &kp JIS_UNDER          &kp N          &kp M  &kp COMMA  &kp DOT  &mt RSHFT JIS_FSLH
&kp LCTRL              &kp LGUI  &kp LALT  &mt_bspc LCTRL BSPC  &lt SYM SPACE  &lt NAV_WIN LANG2    &lt NAV_WIN LANG1  &lt NUM ENTER                             &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        O24 {
            display-name = "O24";
            bindings = <
&kp Q     &kp L   &kp U   &kp COMMA  &kp DOT                      &kp F   &kp W  &kp R  &kp Y  &kp P
&kp E     &kp I   &kp A   &kp O      &kp MINUS            &trans  &kp K   &kp T  &kp N  &kp S  &kp H
&kp FSLH  &kp Z   &kp X   &kp C      &kp V      &trans    &trans  &kp G   &kp D  &kp M  &kp J  &kp B
&trans    &trans  &trans  &trans     &trans     &trans    &trans  &trans                       &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        sym_layer {
            display-name = "SYM";
            bindings = <
&kp JIS_EXCL   &kp JIS_DQT    &kp JIS_HASH  &kp JIS_DLR    &kp JIS_PCT                                  &kp JIS_AMPS  &kp JIS_QUOTE  &kp JIS_LPAR  &kp JIS_RPAR  &kp JIS_PIPE
&kp JIS_CARET  &kp JIS_TILDE  &kp JIS_PLUS  &kp JIS_MINUS  &kp JIS_STAR                  &kp JIS_YEN    &kp JIS_LBRC  &kp JIS_RBRC   &kp JIS_LBKT  &kp JIS_RBKT  &kp JIS_EQUAL
&kp N1         &kp N2         &kp N3        &kp N4         &kp N5        &kp JIS_SEMI    &kp JIS_COLON  &kp N6        &kp N7         &kp N8        &kp N9        &kp N0
&trans         &trans         &trans        &kp BSPC       &trans        &trans          &trans         &kp ENTER                                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        num_layer {
            display-name = "NUM";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                     &kp KP_MULTIPLY  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_DIVIDE
&kp F6   &kp F7   &kp F8  &kp F9  &kp F10            &trans  &kp KP_PLUS      &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS
&kp F11  &kp F12  &trans  &trans  &trans   &trans    &trans  &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT
&trans   &trans   &trans  &trans  &trans   &trans    &trans  &kp ENTER                                         &kp DEL
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        nav_mac_layer {
            display-name = "NAV-M";
            bindings = <
&kp ESC    &trans     &kp UP     &trans     &kp LC(UP)                    &trans        &ss_window_mac  &kp UP    &kp LG(LS(N4))  &kp LG(LS(N3))
&kp HOME   &kp LEFT   &kp DOWN   &kp RIGHT  &kp END               &trans  &kp C_MUTE    &kp LEFT        &kp DOWN  &kp RIGHT       &trans
&kp LSHFT  &kp PG_UP  &kp PG_DN  &trans     &kp ENTER   &trans    &trans  &kp C_BRI_DN  &kp C_PREV      &kp C_PP  &kp C_NEXT      &kp C_BRI_UP
&trans     &trans     &trans     &kp BSPC   &kp SPACE   &trans    &trans  &kp ENTER                                               &kp DEL
            >;

            sensor-bindings = <&rsr_vol>;
        };

        nav_win_layer {
            display-name = "NAV-W";
            bindings = <
&kp ESC    &trans     &kp UP     &trans     &kp LG(TAB)                    &trans        &kp LA(PSCRN)  &kp UP    &kp LG(LS(S))  &kp PSCRN
&kp HOME   &kp LEFT   &kp DOWN   &kp RIGHT  &kp END                &trans  &kp C_MUTE    &kp LEFT       &kp DOWN  &kp RIGHT      &trans
&kp LSHFT  &kp PG_UP  &kp PG_DN  &trans     &kp ENTER    &trans    &trans  &kp C_BRI_DN  &kp C_PREV     &kp C_PP  &kp C_NEXT     &kp C_BRI_UP
&trans     &trans     &trans     &kp BSPC   &kp SPACE    &trans    &trans  &kp ENTER                                             &kp DEL
            >;

            sensor-bindings = <&rsr_vol>;
        };

        mouse_layer {
            display-name = "MOUSE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans    &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &mkp MB1  &mkp MB3  &mkp MB2  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB4  &trans    &mkp MB5  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                                &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        ble_layer {
            display-name = "BLE";
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt_mac0      &bt_win1  &bt_win2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &out OUT_TOG  &trans    &trans    &trans        &studio_unlock
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans    &trans    &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                          &bt BT_CLR_ALL
            >;

            sensor-bindings = <&rsr_vol>;
        };

        gesture_pan_layer {
            display-name = "PAN";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        gesture_snap_mac_layer {
            display-name = "SNAP-M";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        gesture_snap_win_layer {
            display-name = "SNAP-W";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };

        cursor_layer {
            display-name = "CURSOR";
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            sensor-bindings = <&scroll_up_down>;
        };
    };
};

// ---- マウスジェスチャー設定 ----
// Mac: Rectangle のデフォルトショートカット (Ctrl+Option+矢印)。変更する場合はここを修正。

&zip_mouse_gesture {
    stroke-size = <200>;          // cpi=800 でフリック距離が従来(150@600cpi)と同等になる値
    enable-eager-mode;
    gesture-cooldown-ms = <200>;
    always-active;                // &lt によるレイヤー起動のみで動作させる(起動キー &mouse_gesture 不要)

    snap_left {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LC(LA(LEFT))>;
    };

    snap_right {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LC(LA(RIGHT))>;
    };

    snap_max {
        pattern = <GESTURE_UP>;
        bindings = <&kp LC(LA(RET))>;
    };

    snap_center {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LC(LA(C))>;
    };

    snap_tl {
        pattern = <GESTURE_UP_LEFT>;
        bindings = <&kp LC(LA(U))>;
    };

    snap_tr {
        pattern = <GESTURE_UP_RIGHT>;
        bindings = <&kp LC(LA(I))>;
    };

    snap_bl {
        pattern = <GESTURE_DOWN_LEFT>;
        bindings = <&kp LC(LA(J))>;
    };

    snap_br {
        pattern = <GESTURE_DOWN_RIGHT>;
        bindings = <&kp LC(LA(K))>;
    };
};

// Win: 標準スナップ (Win+矢印)

&zip_mouse_gesture_win {
    stroke-size = <200>;          // cpi=800 でフリック距離が従来(150@600cpi)と同等になる値
    enable-eager-mode;
    gesture-cooldown-ms = <200>;
    always-active;                // &lt によるレイヤー起動のみで動作させる(起動キー &mouse_gesture 不要)

    snap_left_w {
        pattern = <GESTURE_LEFT>;
        bindings = <&kp LG(LEFT)>;
    };

    snap_right_w {
        pattern = <GESTURE_RIGHT>;
        bindings = <&kp LG(RIGHT)>;
    };

    snap_max_w {
        pattern = <GESTURE_UP>;
        bindings = <&kp LG(UP)>;
    };

    snap_rest_w {
        pattern = <GESTURE_DOWN>;
        bindings = <&kp LG(DOWN)>;
    };

    snap_tl_w {
        pattern = <GESTURE_UP_LEFT>;
        bindings = <&snap_w_tl>;
    };

    snap_tr_w {
        pattern = <GESTURE_UP_RIGHT>;
        bindings = <&snap_w_tr>;
    };

    snap_bl_w {
        pattern = <GESTURE_DOWN_LEFT>;
        bindings = <&snap_w_bl>;
    };

    snap_br_w {
        pattern = <GESTURE_DOWN_RIGHT>;
        bindings = <&snap_w_br>;
    };
};
